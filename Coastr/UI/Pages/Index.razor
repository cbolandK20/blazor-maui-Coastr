@page "/"
@page "/coaster"

@inject StateContainer state
@inject ICoasterService service
@inject IVenueService venueService
@inject ILocationService locationService
@inject WindowStateHandler handler
@inject NavigationManager navigation

@if (_model != null)
{
    <CoasterComponent Model="_model" />

    <SectionContent SectionName="@MagicStrings.SECTION_APP_HEADER_BUTTON">
        <div class="button-grid-2-rtl">
            <MudIconButton Icon="fa-solid fa-rotate" OnClick="RefreshState" />
            @if (_model.Id.HasValue)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" OnClick="JumpToBill" />
            }
        </div>
    </SectionContent>

    <SectionContent SectionName="@MagicStrings.SECTION_APP_HEADER_TEXT">
        <AppHeaderText HeaderTextClickAction="JumpToVenue" />
    </SectionContent>
}
@code {

    private Coaster _model = null;

    protected override void OnInitialized()
    {

    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Venue venue = null;
        state.CurrentPosition = await locationService.GetCurrentLocationAsync();

        if (state.HasPosition)
        {
            _model = await service.GetCurrentCoasterByPositionAsync(state.CurrentPosition, state.Settings.LocationThreshold);
            if (_model == null)
            {
                venue = await venueService.GetCurrentVenueAsync(state.CurrentPosition, state.Settings.LocationThreshold);
                state.CurrentVenue = venue;
                _model = service.CreateCoaster(state.CurrentVenue);
            }
        }

        state.CurrentCoaster = _model;
        state.HeaderText = _model.Venue?.Name;

        return;
    }

    protected async void RefreshState()
    {
        navigation.NavigateTo("/",true);
    }

    protected void JumpToVenue()
    {
        var linkTarget = $"/{MagicStrings.URL_VENUE_EDIT}/{_model.Venue.Id}";
        navigation.NavigateTo(linkTarget, false);
    }

    protected void JumpToBill()
    {
        navigation.NavigateTo(MagicStrings.URL_BILL_LIST, false);
    }
}